# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=quipu

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=24h

# Server
PORT=3000

# Facturación electrónica ARCA (AFIP)
# Clave maestra para cifrar la clave privada del certificado (32+ chars, generarla una vez)
ARCA_MASTER_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Entorno por defecto: homologacion | produccion
ARCA_ENTORNO=homologacion

# DigitalOcean Spaces (PDFs de facturas compartidos por WhatsApp)
# Endpoint del Space (ej: https://nyc3.digitaloceanspaces.com)
DO_SPACES_ENDPOINT=
# Región del Space (ej: nyc3). Opcional, default: nyc3
DO_SPACES_REGION=
# Access key de Spaces
DO_SPACES_KEY=
# Secret key de Spaces
DO_SPACES_SECRET=
# Nombre del bucket (Space, ej: tisolercdn)
DO_SPACES_BUCKET=
# URL pública base para armar los links. Opcional; por defecto se arma como
# https://<DO_SPACES_BUCKET>.<DO_SPACES_REGION>.digitaloceanspaces.com
DO_SPACES_PUBLIC_URL=
